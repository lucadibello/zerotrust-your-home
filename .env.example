###
### System settings
###

## Ethernet network settings
IP_ADDRESS=192.168.0.5
IP_GATEWAY=192.168.0.1
PRIMARY_DNS=192.168.0.253
SECONDARY_DNS=1.1.1.1
SUBNET_MASK=24

## Wi-Fi hotspot settings (optional, set to false on VMs / systems without Wi-Fi)
ENABLE_HOTSPOT=false
HOTSPOT_SSID=example-hotspot
HOTSPOT_PASSWORD=my-super-secret-password

## Firewall settings
LOCAL_NETWORK=192.168.0.0/24
# Interface name: 'ens18' (standard Proxmox/QEMU VirtIO), 'eth0', 'enp0s3', 'end0' (Armbian/SBCs)
IF=ens18
ALLOW_LOCAL_SSH_ACCESS=true
ALLOW_LOCAL_SERVICES_ACCESS=true
ENABLE_FIREWALL_LOGGING=false # useful for debugging network issues. DO not use in production.


## TLS certificate settings
TLS_CERTIFICATE_COUNTRY=CH
TLS_CERTIFICATE_STATE=Ticino
TLS_CERTIFICATE_LOCALITY=Lugano
TLS_CERTIFICATE_ORGANIZATION="Example Inc."

###
### Feature toggles (enable/disable optional services)
###

## Core & Ingress services
ENABLE_TUNNEL=true              # Cloudflare Tunnel (remote access without open ports)
ENABLE_REVERSE_PROXY=true       # Traefik reverse proxy
ENABLE_DNS=true                 # BIND9 internal DNS
ENABLE_MONITORING=true          # Prometheus, Grafana, Alertmanager
ENABLE_LOGGING=true             # Loki, Promtail
ENABLE_BACKUP=true              # Restic backup to S3/Google Drive

## Optional services
ENABLE_HOME_AUTOMATION=false    # Home Assistant, Zigbee2MQTT, Mosquitto
ENABLE_VAULTWARDEN=false        # Self-hosted password manager
ENABLE_NEXTCLOUD=false          # Self-hosted cloud storage
ENABLE_PORTAINER=false          # Docker management UI
ENABLE_NTFY=true                # Self-hosted ntfy push notifications server
ENABLE_GATUS=true               # Gatus service health monitoring & status page
ENABLE_HOMEPAGE=false            # Homepage application dashboard
ENABLE_DIUN=false                # DIUN Docker image update notifier (replaces Watchtower)
ENABLE_ADGUARD=false             # AdGuard Home DNS & DoH ad-blocker
ENABLE_CROWDSEC=false            # CrowdSec intrusion prevention & security engine

## Additional services (requires extra configuration below)
ENABLE_IMMICH=false             # Self-hosted photo library (requires IMMICH_* vars)
ENABLE_SEARXNG=false            # Privacy-focused search engine
ENABLE_MINECRAFT=false          # Minecraft server (requires MC_TUNNEL_TOKEN)

###
### Docker containers environment variables
###

## Traefik environment variables
CLOUDFLARE_EMAIL=example@example.com
CLOUDFLARE_API_KEY=my-super-secret-cloudflare-api-key

## Restic environment variables (Google Drive via Rclone)
# Use 'rclone:<remote>:<bucket/path>'
RESTIC_REPOSITORY=rclone:gdrive:backups
RESTIC_PASSWORD=my-super-secret-password
LOCAL_BACKUP_DIR=/mnt/nextcloud-backups
# Snapshot retention policy (adjust these if you are low on HDD space)
# Default is approx 1 month of backups. For higher retention use: --keep-last 5 --keep-daily 7 --keep-weekly 4 --keep-monthly 12
RESTIC_FORGET_ARGS="--keep-last 3 --keep-daily 3 --keep-weekly 2 --keep-monthly 1"

## Data Directories (Must match your actual setup)
NEXTCLOUD_DATADIR=/mnt/nas-data/nextcloud

## Ntfy notifications environment variables (https://ntfy.sh or self-hosted)
# The topic name to receive notifications on
NTFY_TOPIC=lucadibello-homelab-status
# Base URL for ntfy (e.g. 'https://ntfy.home.lucadibello.ch' if self-hosting with ENABLE_NTFY=true, or 'https://ntfy.sh')
NTFY_URL=https://ntfy.home.lucadibello.ch
# Optional access token (for protected topics requiring authentication)
NTFY_TOKEN=

## CloudFlare Tunnel environment variables
TUNNEL_TOKEN=my-super-secret-tunnel-token

## DNS environment variables
DNS_DOMAIN=example.com
DNS_EMAIL=example@example.com

###
### Immich environment variables (required if ENABLE_IMMICH=true)
###

IMMICH_UPLOAD_LOCATION=/mnt/nas-data/immich
IMMICH_DB_DATA_LOCATION=immich_db_data
TZ=Europe/Zurich
IMMICH_VERSION=release
IMMICH_DB_PASSWORD=postgres
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_API_KEY=Z9xwcc3HUoOkVHk83aygaqZxNNKjX0ADyWRCyxOU
IMMICH_BACKUP_LOCATION=/mnt/nextcloud-backups/immich

###
### Minecraft server environment variables (required if ENABLE_MINECRAFT=true)
###

MC_TUNNEL_TOKEN=my-minecraft-tunnel-token

##
## SearXNG server environment variables (required if ENABLE_SEARXNG=true)
##

SEARCHXNG_SECRET_KEY=my-super-secret-secret-key
