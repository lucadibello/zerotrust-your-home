###
### System settings
###

## Ethernet network settings
IP_ADDRESS=192.168.0.5
IP_GATEWAY=192.168.0.1
DNS_SERVERS="192.168.0.5 1.1.1.1"
SUBNET_MASK=24

## Wi-Fi hotspot settings
ENABLE_HOTSPOT=true
HOTSPOT_SSID=example-hotspot
HOTSPOT_PASSWORD=my-super-secret-password

## Firewall settings
LOCAL_NETWORK=192.168.0.0/24
IF=end0
ALLOW_LOCAL_SSH_ACCESS=true
ALLOW_LOCAL_SERVICES_ACCESS=true

## TLS certificate settings
TLS_CERTIFICATE_COUNTRY=CH
TLS_CERTIFICATE_STATE=Ticino
TLS_CERTIFICATE_LOCALITY=Lugano
TLS_CERTIFICATE_ORGANIZATION="Example Inc."

###
### Feature toggles (enable/disable optional services)
###

## Core services (recommended to keep enabled)
ENABLE_MONITORING=true          # Prometheus, Grafana, Alertmanager
ENABLE_LOGGING=true             # Loki, Promtail
ENABLE_BACKUP=true              # Restic backup to S3
ENABLE_DNS=true                 # BIND9 internal DNS
ENABLE_REVERSE_PROXY=true       # Traefik reverse proxy

## Optional services
ENABLE_HOME_AUTOMATION=false    # Home Assistant, Zigbee2MQTT, Mosquitto
ENABLE_VAULTWARDEN=false        # Self-hosted password manager
ENABLE_NEXTCLOUD=false          # Self-hosted cloud storage
ENABLE_PORTAINER=false          # Docker management UI
ENABLE_UPTIME_KUMA=false        # Service health monitoring
ENABLE_WATCHTOWER=false         # Automatic container updates

## Additional services (requires extra configuration below)
ENABLE_IMMICH=false             # Self-hosted photo library (requires IMMICH_* vars)
ENABLE_SEARXNG=false            # Privacy-focused search engine
ENABLE_MINECRAFT=false          # Minecraft server (requires MC_TUNNEL_TOKEN)

###
### Docker containers environment variables
###

## Traefik environment variables
CLOUDFLARE_EMAIL=example@example.com
CLOUDFLARE_API_KEY=my-super-secret-cloudflare-api-key

## Restic environment variables
RESTIC_REPOSITORY=s3:https://s3.amazonaws.com/bucket.example.com
RESTIC_PASSWORD=my-super-secret-password
AWS_DEFAULT_REGION=eu-central-1
AWS_ACCESS_KEY_ID=my-super-secret-aws-access-key-id
AWS_SECRET_ACCESS_KEY=my-super-secret-aws-access-key

## Telegram bot environment variables
TELEGRAM_BOT_TOKEN=my-super-secret-bot-token
TELEGRAM_CHAT_ID=my-super-secret-chat-id

## CloudFlare Tunnel environment variables
TUNNEL_TOKEN=my-super-secret-tunnel-token

## DNS environment variables
DNS_DOMAIN=example.com
DNS_EMAIL=example@example.com

###
### Immich environment variables (required if ENABLE_IMMICH=true)
###

IMMICH_UPLOAD_LOCATION=/mnt/nas-data/library
IMMICH_DB_DATA_LOCATION=immich_db_data
TZ=Europe/Zurich
IMMICH_VERSION=release
IMMICH_DB_PASSWORD=postgres
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_API_KEY=Z9xwcc3HUoOkVHk83aygaqZxNNKjX0ADyWRCyxOU
IMMICH_BACKUP_LOCATION=/mnt/nextcloud-backups/immich

###
### Minecraft server environment variables (required if ENABLE_MINECRAFT=true)
###

MC_TUNNEL_TOKEN=my-minecraft-tunnel-token
