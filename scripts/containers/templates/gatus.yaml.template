web:
  port: 8080

ui:
  title: "ZeroTrust Home Status"
  header: "System Status & Service Health"
  link: "https://<DNS_DOMAIN>"

alerting:
  ntfy:
    url: "<NTFY_URL>"
    topic: "<NTFY_TOPIC>"
    token: "<NTFY_TOKEN>"
    priority: 3
    default-alert:
      enabled: true
      failure-threshold: 3
      success-threshold: 2
      send-on-resolved: true

storage:
  type: sqlite
  path: /data/data.db

# Service endpoints are dynamically generated by scripts/containers/setup-gatus.sh
# based on feature flags defined in .env (ENABLE_REVERSE_PROXY, ENABLE_MONITORING, etc.)
