web:
  port: 8080

ui:
  title: "ZeroTrust Home Status"
  header: "System Status & Service Health"
  link: "https://<DNS_DOMAIN>"

alerting:
  ntfy:
    url: "<NTFY_URL>"
    topic: "<NTFY_TOPIC>"
    token: "<NTFY_TOKEN>"
    priority: 3
    default-alert:
      enabled: true
      failure-threshold: 3
      success-threshold: 2
      send-on-resolved: true

storage:
  type: sqlite
  path: /data/data.db

endpoints:
  # --- Core Infrastructure ---
  - name: Traefik Ingress
    group: Core Infrastructure
    url: "http://traefik:80/ping"
    interval: 30s
    conditions:
      - "[STATUS] == 200"
      - "[BODY] == OK"
    alerts:
      - type: ntfy
        enabled: true

  - name: Ntfy (Push Notifications)
    group: Core Infrastructure
    url: "http://ntfy:80/v1/health"
    interval: 60s
    conditions:
      - "[STATUS] == 200"
      - "[BODY].healthy == true"
    alerts:
      - type: ntfy
        enabled: true

  # --- Monitoring & Observability ---
  - name: Prometheus
    group: Monitoring
    url: "http://prometheus:9090/-/healthy"
    interval: 30s
    conditions:
      - "[STATUS] == 200"
      - "[BODY] == pat(*Prometheus Server is Healthy.*)"
    alerts:
      - type: ntfy
        enabled: true

  - name: Alertmanager
    group: Monitoring
    url: "http://alertmanager:9093/-/healthy"
    interval: 30s
    conditions:
      - "[STATUS] == 200"
      - "[BODY] == OK"
    alerts:
      - type: ntfy
        enabled: true

  - name: Grafana
    group: Monitoring
    url: "http://grafana:3000/api/health"
    interval: 30s
    conditions:
      - "[STATUS] == 200"
      - "[BODY].database == ok"
    alerts:
      - type: ntfy
        enabled: true

  - name: Loki
    group: Logging
    url: "http://loki:3100/ready"
    interval: 30s
    conditions:
      - "[STATUS] == 200"
      - "[BODY] == ready"
    alerts:
      - type: ntfy
        enabled: true

  # --- Security & Applications ---
  - name: Vaultwarden
    group: Security
    url: "http://vaultwarden:80/alive"
    interval: 60s
    conditions:
      - "[STATUS] == 200"
    alerts:
      - type: ntfy
        enabled: true

  - name: Home Assistant
    group: Home Automation
    url: "http://homeassistant:8123"
    interval: 60s
    conditions:
      - "[STATUS] == 200 || [STATUS] == 302 || [STATUS] == 401"
    alerts:
      - type: ntfy
        enabled: true

  - name: Zigbee2MQTT
    group: Home Automation
    url: "http://zigbee2mqtt:8080"
    interval: 60s
    conditions:
      - "[STATUS] == 200"
    alerts:
      - type: ntfy
        enabled: true

  - name: Immich
    group: Applications
    url: "http://immich_server:2283/api/server-info/ping"
    interval: 60s
    conditions:
      - "[STATUS] == 200"
      - "[BODY].res == pong"
    alerts:
      - type: ntfy
        enabled: true

  - name: Nextcloud
    group: Applications
    url: "http://nextcloud-aio-apache:11000"
    interval: 60s
    conditions:
      - "[STATUS] == 200 || [STATUS] == 302 || [STATUS] == 503"
    alerts:
      - type: ntfy
        enabled: true

  - name: SearXNG
    group: Applications
    url: "http://searxng-app:8080"
    interval: 60s
    conditions:
      - "[STATUS] == 200"
    alerts:
      - type: ntfy
        enabled: true

  - name: Portainer
    group: Management
    url: "http://portainer:9000"
    interval: 60s
    conditions:
      - "[STATUS] == 200 || [STATUS] == 302"
    alerts:
      - type: ntfy
        enabled: true
