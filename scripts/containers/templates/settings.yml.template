# SearXNG settings
# For more options see: https://docs.searxng.org/admin/settings/settings.html
use_default_settings: true

server:
  # IMPORTANT: Change this to a random string in production!
  secret_key: "<SEARCHXNG_SECRET_KEY>"
  limiter: false
  image_proxy: true

ui:
  default_locale: en

# Optional: Enable TOR proxy for enhanced privacy
# Uncomment and configure if you want to route searches through TOR
